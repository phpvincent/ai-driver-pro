{
  "name": "ai-video-driver",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "test": "vitest run --passWithNoTests",
    "check:redlines": "node scripts/check-redlines.mjs",
    "check:prompts": "node scripts/check-prompts.mjs",
    "verify": "tsc --noEmit && vitest run && node scripts/check-redlines.mjs && vite build"
  },
  "dependencies": {
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "mermaid": "^11.17.2",
    "react": "18.3",
    "react-dom": "18.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/react": "18.3",
    "@types/react-dom": "18.3",
    "@vitejs/plugin-react": "4.3",
    "typescript": "5.6",
    "vite": "5.4",
    "vitest": "2.1"
  }
}